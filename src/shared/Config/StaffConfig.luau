function StaffConfig.GetStaff(id: string): StaffData?
	return staves[id]
end

function StaffConfig.Exists(id: string): boolean
	return staves[id] ~= nil
end

function StaffConfig.GetAllIds(): { string }
	local ids = {}
	for id, _ in pairs(staves) do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		return staves[a].Number < staves[b].Number
	end)
	return ids
end

function StaffConfig.GetAllStaves(): { StaffData }
	local list = {}
	for _, staff in pairs(staves) do
		table.insert(list, staff)
	end
	table.sort(list, function(a, b)
		return a.Number < b.Number
	end)
	return list
end

return table.freeze(StaffConfig)
