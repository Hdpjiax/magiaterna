function RecipeConfig.GetRecipe(targetId: string): RecipeDefinition?
	return recipes[targetId]
end

function RecipeConfig.Exists(targetId: string): boolean
	return recipes[targetId] ~= nil
end

function RecipeConfig.GetAllRecipes(): { RecipeDefinition }
	local list = {}
	for _, r in pairs(recipes) do
		table.insert(list, r)
	end
	table.sort(list, function(a, b) return a.TargetId < b.TargetId end)
	return list
end

function RecipeConfig.GetRecipesByCategory(category: "Staff" | "Armor"): { RecipeDefinition }
	local list = {}
	for _, r in pairs(recipes) do
		if r.Category == category then
			table.insert(list, r)
		end
	end
	table.sort(list, function(a, b) return a.TargetId < b.TargetId end)
	return list
end

return table.freeze(RecipeConfig)
