function PetConfig.GetPet(id: string): PetDefinition?
	return pets[id]
end

function PetConfig.CalculateStats(id: string, tier: PetTier?): {
	MagicBonus: number,
	CoinsBonus: number,
	LuckBonus: number,
	MaterialsBonus: number,
}
	local def = pets[id]
	if not def then
		return { MagicBonus = 0, CoinsBonus = 0, LuckBonus = 0, MaterialsBonus = 0 }
	end
	local mult = PetConfig.TIER_MULTIPLIERS[tier or "Normal"] or 1.0
	return {
		MagicBonus = math.floor(def.MagicBonusPercent * mult),
		CoinsBonus = math.floor(def.CoinsBonusPercent * mult),
		LuckBonus = math.floor(def.LuckBonusPercent * mult),
		MaterialsBonus = math.floor(def.MaterialsBonusPercent * mult),
	}
end

function PetConfig.Exists(id: string): boolean
	return pets[id] ~= nil
end

function PetConfig.GetAllPets(): { PetDefinition }
	local list = {}
	for _, pet in pairs(pets) do
		table.insert(list, pet)
	end
	table.sort(list, function(a, b) return a.Id < b.Id end)
	return list
end

return table.freeze(PetConfig)
