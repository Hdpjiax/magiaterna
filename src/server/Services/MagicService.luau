--!strict
--[[
    MagicService.luau
    Core Magic Simulation Service for MAGIA ETERNA.
    Calculates power per click and training pulses based on equipped staff, rebirth multiplier,
    and pet bonuses. Atomically updates player data and replicates to client.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig") :: ModuleScript)
local StaffConfig = require(Shared:WaitForChild("Config"):WaitForChild("StaffConfig") :: ModuleScript)
local RebirthConfig = require(Shared:WaitForChild("Config"):WaitForChild("RebirthConfig") :: ModuleScript)
local NetworkEndpoints = require(Shared:WaitForChild("Network"):WaitForChild("NetworkEndpoints") :: ModuleScript)

local Services = script.Parent
local PlayerDataService = require(Services:WaitForChild("PlayerDataService") :: ModuleScript)
local RemoteGuard = require(Services:WaitForChild("RemoteGuard") :: ModuleScript)
local PetService = require(Services:WaitForChild("PetService") :: ModuleScript)
local QuestService = require(Services:WaitForChild("QuestService") :: ModuleScript)
local TutorialService = require(Services:WaitForChild("TutorialService") :: ModuleScript)

local MagicService = {}

-- Calculates the power generated by a training click for the given player
function MagicService.CalculatePower(player: Player): number
	local profile = PlayerDataService.GetProfile(player)
	if not profile then return 1 end
	
	-- 1. Base Power & Staff Power
	local basePower = 1
	local staffPower = 0
	local staffData = StaffConfig.GetStaff(profile.EquippedStaff)
	if staffData then
		staffPower = staffData.BasePower
	end
	
	-- 2. Rebirth Multiplier
	local rebirthMult = RebirthConfig.GetMultiplier(profile.Rebirths)
	
	-- 3. Pet Multipliers
	local petMultiplier = PetService.GetTotalMagicMultiplier(player)
	
	-- 4. Multiplicador VIP (x1.2 permanente de Magia)
	local vipMultiplier = 1.0
	if profile.OwnedGamePasses and profile.OwnedGamePasses.GP_VIP then
		vipMultiplier = 1.2
	end

	-- Total Calculation: P_clic = (Base + Staff) * RebirthMult * PetMult * VIPMult
	local totalPower = (basePower + staffPower) * rebirthMult * petMultiplier * vipMultiplier
	return math.max(1, math.floor(totalPower))
end

-- Executes a training click for the player
function MagicService.Train(player: Player): (boolean, number)
	if not RemoteGuard.Validate(player, "ClickMagic") then
		return false, 0
	end
	
	local powerGained = MagicService.CalculatePower(player)
	
	-- Atomically increment magic in player profile
	local updateSuccess = PlayerDataService.UpdateProfile(player, function(data)
		data.Magic += powerGained
	end)
	
	if updateSuccess then
		QuestService.RecordProgress(player, "TrainMagic", 1)
		TutorialService.RecordAction(player, "TrainMagic", 1)
	end
	
	return updateSuccess, powerGained
end

-- Initializes MagicService and hooks remote events
function MagicService.Init()
	local trainEvent = NetworkEndpoints.GetEvent(NetworkEndpoints.Events.RequestTrainMagic)
	trainEvent.OnServerEvent:Connect(function(player: Player)
		MagicService.Train(player)
	end)
	
	print("[MagicService] Initialized and connected to RequestTrainMagic.")
end

return table.freeze(MagicService)
